{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git commit*": "allow",
      "git merge*": "ask",
      "git push*": "ask"
    }
  },
  "mcp": {
    "figsor": {
      "type": "local",
      "command": ["npx", "-y", "figsor"],
      "enabled": true,
      "environment": {}
    },
    "mini-figma": {
      "type": "local",
      "command": ["node", "mini-figma/mcp-server/dist/server.js"],
      "enabled": true
    }
  }
}
